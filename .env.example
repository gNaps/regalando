# App Next.js: copiare in .env.local senza eliminare le variabili esistenti.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CONVEX_URL=

# Scritte automaticamente da `pnpm convex:dev`; non servono altrove nell'app.
# CONVEX_DEPLOYMENT=
# NEXT_PUBLIC_CONVEX_SITE_URL=

# Impostare anche sul deployment Convex, non soltanto in .env.local.
CLERK_JWT_ISSUER_DOMAIN=
# Opzionale, rinviato dopo il primo rilascio: lasciare vuoto senza webhook.
# Per una futura attivazione, impostare solo sul deployment Convex.
CLERK_WEBHOOK_SIGNING_SECRET=
